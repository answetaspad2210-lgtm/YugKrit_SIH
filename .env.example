# Copy this file to .env and fill in real values. Never commit .env to git.

# Flask / app
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=your_secret_key_here
JWT_SECRET=your_jwt_secret_here
FRONTEND_URL=http://localhost:5000
BACKEND_URL=http://localhost:5000
WEBSOCKET_URL=ws://localhost:5000

# Database
# SQLite is the default local development database.
# To move to PostgreSQL later, set e.g.:
# DATABASE_URL=postgresql://user:password@localhost:5432/yugkrit
DATABASE_URL=sqlite:///yugkrit.db

# AI / integrations
AI_API_KEY=
EMAIL_API_KEY=
STORAGE_BUCKET=yugkrit-uploads

# WhatsApp OTP delivery
WHATSAPP_PROVIDER=console
WHATSAPP_DEFAULT_COUNTRY_CODE=+91
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_NAME=yugkrit_otp
WHATSAPP_TEMPLATE_LANGUAGE=en_US

# Runtime / deployment overrides
APP_PORT=5000
SESSION_COOKIE_SECURE=0
CORS_ALLOWED_ORIGINS=http://localhost:5000

# Optional: production deployment values
DATABASE_POOL_SIZE=5
