{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "YugKrit Flask",
            "type": "debugpy",
            "request": "launch",
            "preLaunchTask": "YugKrit: seed database",
            "program": "${workspaceFolder}/app.py",
            "cwd": "${workspaceFolder}",
            "env": {
                "FLASK_ENV": "development",
                "FLASK_DEBUG": "1"
            },
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "Running on http://127\\.0\\.0\\.1:([0-9]+)",
                "uriFormat": "http://127.0.0.1:%s/"
            },
            "jinja": true,
            "justMyCode": true
        }
    ]
}
